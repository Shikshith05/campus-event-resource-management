# The app connects as cerms_app (created by db/sql/rbac.sql), NOT as the
# cerms superuser: a superuser would bypass row-level security. cerms_app
# can only SET ROLE to cerms_student / cerms_faculty / cerms_admin.
# Development password only.
DATABASE_URL=postgresql://cerms_app:cerms_app_dev@127.0.0.1:5433/cerms
MONGODB_URI=mongodb://127.0.0.1:27017/cerms
# At least 32 random characters; signs the session cookie.
SESSION_SECRET=replace-with-a-long-random-development-secret
