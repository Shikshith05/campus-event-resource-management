// CERMS - Campus Event and Resource Management System
// Paste this file into https://dbdiagram.io to draw the ER diagram.
// Source of truth is db/sql/schema.sql; keep the two in sync.
// CHECK and EXCLUDE constraints cannot be drawn in DBML, so they are
// written as notes.

Project CERMS {
  database_type: 'PostgreSQL'
  Note: 'Campus Event and Resource Management System (PES University, DBMS project)'
}

Table department {
  department_id int [pk, increment]
  code varchar(10) [not null, unique, note: 'e.g. CSE']
  name varchar(100) [not null, unique]
}

Table role {
  role_id int [pk, increment]
  role_name varchar(30) [not null, unique, note: 'STUDENT, CLUB_COORDINATOR, FACULTY, HOD, ADMIN']
  hierarchy_level smallint [not null, note: 'CHECK > 0; higher = more authority']
  description varchar(200)
}

Table app_user {
  user_id int [pk, increment]
  university_id varchar(20) [not null, unique, note: 'SRN or employee ID']
  full_name varchar(100) [not null]
  email varchar(120) [not null, unique, note: 'CHECK: contains @ and is lowercase']
  password_hash text [not null]
  role_id int [not null]
  department_id int [note: 'NULL for central admin staff']
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
}

Table club {
  club_id int [pk, increment]
  name varchar(100) [not null, unique]
  description text
  department_id int [note: 'NULL = campus-wide club']
  faculty_advisor_id int [not null]
  is_active boolean [not null, default: true]
}

Table club_member {
  club_id int [not null]
  user_id int [not null]
  club_position varchar(20) [not null, default: 'MEMBER', note: 'CHECK IN (MEMBER, COORDINATOR)']
  joined_on date [not null, default: `CURRENT_DATE`]

  indexes {
    (club_id, user_id) [pk]
  }
}

Table venue {
  venue_id int [pk, increment]
  name varchar(100) [not null, unique]
  venue_type varchar(20) [not null, note: 'CHECK IN (AUDITORIUM, SEMINAR_HALL, CLASSROOM, LAB, OPEN_AIR, OTHER)']
  building varchar(100)
  capacity int [not null, note: 'CHECK > 0']
  department_id int [note: 'NULL = managed centrally']
  is_active boolean [not null, default: true]
}

Table resource {
  resource_id int [pk, increment]
  name varchar(100) [not null, unique]
  resource_type varchar(20) [not null, note: 'CHECK IN (AV, FURNITURE, POWER, DECOR, OTHER)']
  total_quantity int [not null, note: 'CHECK >= 0']
  is_active boolean [not null, default: true]
}

Table event {
  event_id int [pk, increment]
  title varchar(150) [not null]
  description text
  category varchar(20) [not null, note: 'CHECK IN (ACADEMIC, DEPARTMENT, CLUB, PERSONAL)']
  event_type varchar(20) [not null, note: 'CHECK IN (GUEST_LECTURE, WORKSHOP, SEMINAR, TECH_FEST, CULTURAL, CLUB_MEET, ORIENTATION, COMPETITION, SPORTS, OTHER)']
  organizer_id int [not null, note: 'the requester']
  department_id int [note: 'required unless category = PERSONAL']
  club_id int [note: 'required if and only if category = CLUB']
  expected_footfall int [not null, note: 'CHECK > 0']
  status varchar(20) [not null, default: 'DRAFT', note: 'CHECK IN (DRAFT, PENDING_APPROVAL, APPROVED, REJECTED, CANCELLED)']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    organizer_id [name: 'idx_event_organizer']
  }
}

Table event_venue_preference {
  event_id int [not null]
  venue_id int [not null]
  preference_order smallint [not null, note: 'positive and unique per event']

  indexes {
    (event_id, venue_id) [pk]
    (event_id, preference_order) [unique]
  }
}

Table guest_lecture_details {
  event_id int [pk]
  guest_name varchar(150) [not null]
  guest_affiliation varchar(200) [not null]
  talk_topic varchar(250) [not null]
}

Table booking {
  booking_id int [pk, increment]
  event_id int [not null]
  venue_id int [not null]
  start_time timestamptz [not null]
  end_time timestamptz [not null, note: 'CHECK end_time > start_time']
  status varchar(20) [not null, default: 'PENDING', note: 'CHECK IN (PENDING, CONFIRMED, REJECTED, CANCELLED, COMPLETED, NO_SHOW)']
  requested_at timestamptz [not null, default: `now()`, note: 'CHECK start_time > requested_at']

  indexes {
    (venue_id, start_time) [name: 'idx_booking_venue_time']
    event_id [name: 'idx_booking_event']
  }

  Note: 'EXCLUDE: two CONFIRMED bookings of the same venue cannot overlap in time'
}

Table booking_resource {
  booking_id int [not null]
  resource_id int [not null]
  quantity int [not null, note: 'CHECK > 0']

  indexes {
    (booking_id, resource_id) [pk]
  }
}

Table booking_conflict_log {
  conflict_id int [pk, increment]
  winning_booking_id int [not null]
  losing_booking_id int [not null]
  winner_score numeric(6,2) [not null]
  loser_score numeric(6,2) [not null]
  reason text
  decided_by int [note: 'NULL = automatic decision; else the overriding admin']
  decided_at timestamptz [not null, default: `now()`]

  indexes {
    (winning_booking_id, losing_booking_id) [unique]
  }

  Note: 'CHECK winning <> losing; CHECK decided_by IS NOT NULL OR winner_score >= loser_score'
}

// Foreign keys with their ON DELETE behaviour
Ref: app_user.role_id > role.role_id [delete: restrict]
Ref: app_user.department_id > department.department_id [delete: restrict]
Ref: club.department_id > department.department_id [delete: set null]
Ref: club.faculty_advisor_id > app_user.user_id [delete: restrict]
Ref: club_member.club_id > club.club_id [delete: cascade]
Ref: club_member.user_id > app_user.user_id [delete: cascade]
Ref: venue.department_id > department.department_id [delete: set null]
Ref: event.organizer_id > app_user.user_id [delete: restrict]
Ref: event.department_id > department.department_id [delete: restrict]
Ref: event.club_id > club.club_id [delete: restrict]
Ref: event_venue_preference.event_id > event.event_id [delete: cascade]
Ref: event_venue_preference.venue_id > venue.venue_id [delete: restrict]
Ref: guest_lecture_details.event_id > event.event_id [delete: cascade]
Ref: booking.event_id > event.event_id [delete: cascade]
Ref: booking.venue_id > venue.venue_id [delete: restrict]
Ref: booking_resource.booking_id > booking.booking_id [delete: cascade]
Ref: booking_resource.resource_id > resource.resource_id [delete: restrict]
Ref: booking_conflict_log.winning_booking_id > booking.booking_id [delete: restrict]
Ref: booking_conflict_log.losing_booking_id > booking.booking_id [delete: restrict]
Ref: booking_conflict_log.decided_by > app_user.user_id [delete: restrict]
